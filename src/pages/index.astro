---
import Booking from '../components/home/Booking.astro';
import ClosingCta from '../components/home/ClosingCta.astro';
import FocusAreas from '../components/home/FocusAreas.astro';
import Hero from '../components/home/Hero.astro';
import TherapistSpotlight from '../components/home/TherapistSpotlight.astro';
import Workshops from '../components/home/Workshops.astro';
import portrait from '../assets/rhonda-hilker-portrait.png';
import Layout from '../layouts/Layout.astro';

const title = 'Rhonda Hilker, MSW, RSW | Joyful Minds Counselling';
const description =
  'Compassionate, evidence-based counselling and therapy with Rhonda Hilker, MSW, RSW — virtual counselling for adults across Alberta and Ontario.';
---

<Layout title={title} description={description}>
  <Hero />
  <TherapistSpotlight portrait={portrait} />
  <FocusAreas />
  <Workshops />
  <Booking />
  <ClosingCta />
</Layout>
