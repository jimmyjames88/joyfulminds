---
import Booking from '../components/home/Booking.astro';
import ClosingCta from '../components/home/ClosingCta.astro';
import FocusAreas from '../components/home/FocusAreas.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCategories from '../components/home/ServiceCategories.astro';
import TherapistSpotlight from '../components/home/TherapistSpotlight.astro';
import portrait from '../assets/rhonda-hilker-portrait.png';
import Layout from '../layouts/Layout.astro';

const title = 'Online Counselling Alberta & Ontario | Joyful Minds';
const description =
  'Online counselling across Alberta and Ontario with Rhonda Hilker, MSW, RSW. Explore support and book a free 30-minute consultation.';
---

<Layout title={title} description={description}>
  <Hero />
  <TherapistSpotlight portrait={portrait} />
  <ServiceCategories />
  <FocusAreas />
  <Booking />
  <ClosingCta />
</Layout>
