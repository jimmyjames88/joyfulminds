---
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ClosingCta from '../../components/home/ClosingCta.astro';
import AnimatedHeroBackground from '../../components/ui/AnimatedHeroBackground.astro';
import Layout from '../../layouts/Layout.astro';
import { mailto, site } from '../../data/site';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const pageTitle = `${service.label} | Joyful Minds Counselling`;
const description = service.introduction;
---

<Layout title={pageTitle} description={description}>
  <section
    aria-labelledby="service-title"
    class:list={['bg-canvas py-16 sm:py-20 lg:py-24', service.slug === 'couples-therapy' && 'relative isolate overflow-hidden']}
  >
    {service.slug === 'couples-therapy' && <AnimatedHeroBackground />}
    <Container width="content" class={service.slug === 'couples-therapy' ? 'relative z-10' : undefined}>
      {service.slug !== 'couples-therapy' && (
        <nav aria-label="Breadcrumb" class="mb-10 text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-terracotta">Home</a></li>
            <li aria-hidden="true">/</li>
            <li>Services</li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-ink">{service.label}</li>
          </ol>
        </nav>
      )}

      {
        service.slug === 'couples-therapy' ? (
          <SectionHeading
            id="service-title"
            eyebrow="Counselling Services"
            title={service.label}
            headingLevel="h1"
            align="center"
            titleClass="mt-3 text-4xl leading-[1.15] font-medium tracking-[-0.02em] sm:text-5xl lg:text-6xl"
          >
            <p class="text-muted">{service.introduction}</p>
          </SectionHeading>
        ) : (
          <SectionHeading
            id="service-title"
            eyebrow="Counselling Services"
            title={service.label}
            headingLevel="h1"
            titleClass="mt-3 text-4xl leading-[1.15] font-medium tracking-[-0.02em] sm:text-5xl lg:text-6xl"
          >
            <p class="max-w-3xl text-muted">{service.introduction}</p>
          </SectionHeading>
        )
      }

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:mt-12">
        <Card class="h-full">
          <h2 class="text-2xl font-medium">What we can explore together</h2>
          <ul class="mt-6 space-y-4">
            {service.topics.map((topic) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink">
                <Icon name="circle-check" class="mt-0.5 size-4 text-terracotta" />
                {topic}
              </li>
            ))}
          </ul>
        </Card>

        <Card tone="tint" class="h-full">
          <h2 class="text-2xl font-medium">{service.approachTitle}</h2>
          <p class="mt-5 text-sm leading-[1.75] text-muted">{service.approach}</p>
          {service.slug !== 'organizations' && (
            <p class="mt-5 border-t border-line pt-4 text-sm leading-relaxed text-muted">{site.serviceArea}</p>
          )}
        </Card>
      </div>

      <div class="mt-20 flex flex-col items-center gap-4 text-center">
        <p class="max-w-xl text-sm leading-relaxed text-muted">
          A complimentary 30-minute conversation is a no-obligation way to ask questions and see whether the service
          feels like a good fit.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={mailto(`${service.label} enquiry`)} icon="arrow-up-right">
            Ask about {service.label}
          </Button>
          <Button href="/contact" variant="outline">Contact Rhonda</Button>
        </div>
      </div>
    </Container>
  </section>

  {
    service.questionSections && (
      <section
        aria-label={`Questions about ${service.label}`}
        class="bg-tint py-16 sm:py-20 lg:py-24"
      >
        <Container width="content">
          <div class="border-t border-line">
            {service.questionSections.map((section, index) => (
              <article
                aria-labelledby={`couples-question-${index}`}
                class="grid gap-4 border-b border-line py-7 sm:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] sm:gap-8 sm:py-9 lg:gap-12"
              >
                <h2 id={`couples-question-${index}`} class="text-2xl leading-[1.25] font-medium sm:text-3xl">
                  {section.title}
                </h2>
                <div class="text-sm leading-[1.75] text-muted sm:text-base">
                  <p>{section.answer}</p>
                  {section.points && (
                    <ul class="mt-4 space-y-3">
                      {section.points.map((point) => (
                        <li class="flex items-start gap-3">
                          <Icon name="circle-check" class="mt-1 size-4 text-terracotta" />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {section.note && <p class="mt-4 border-l-2 border-terracotta/50 pl-4 text-sm">{section.note}</p>}
                </div>
              </article>
            ))}
          </div>
        </Container>
      </section>
    )
  }
  {service.slug === 'couples-therapy' && <ClosingCta />}
</Layout>
