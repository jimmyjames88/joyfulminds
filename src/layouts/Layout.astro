---
import { Font, getImage } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import meadow from '../assets/hero-sunflower-meadow.png';
import logo from '../assets/joyful-minds-logo-square.png';
import portrait from '../assets/rhonda-about-portrait.png';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import MobileNavDrawer from '../components/layout/MobileNavDrawer.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { site } from '../data/site';
import { canonicalUrl, createPageSchema, serializeJsonLd, type PageSchemaOptions } from '../utils/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a social sharing image. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  pageType?: PageSchemaOptions['pageType'];
  breadcrumbLabel?: string;
  service?: PageSchemaOptions['service'];
}

const { title, description, ogImage, pageType, breadcrumbLabel, service } = Astro.props;
if (!Astro.site) throw new Error('The canonical site URL must be configured.');
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const [socialImage, schemaLogo] = await Promise.all([
  getImage({ src: meadow, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 85 }),
  getImage({ src: logo, format: 'png' }),
]);
const ogImageUrl = new URL(ogImage ?? socialImage.src, Astro.site).href;
const ogImageAlt = Astro.props.ogImageAlt ?? (ogImage ? site.name : 'A sunlit sunflower meadow');
const ogImageWidth = Astro.props.ogImageWidth ?? (ogImage ? undefined : 1200);
const ogImageHeight = Astro.props.ogImageHeight ?? (ogImage ? undefined : 630);
const schema = createPageSchema({
  practice: site,
  canonical,
  title,
  description,
  logoUrl: new URL(schemaLogo.src, Astro.site).href,
  portraitUrl: new URL(portrait.src, Astro.site).href,
  pageType,
  breadcrumbLabel,
  service,
});
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 256x256" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script id="page-schema" type="application/ld+json" set:html={serializeJsonLd(schema)} />

    <meta name="theme-color" content="#17111F" />
    <ClientRouter fallback="swap" />

    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-jakarta" preload />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only z-[60] rounded-full bg-forest-deep px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to main content
    </a>
    <div data-page-shell>
      <SiteHeader />
      <main id="main" tabindex="-1" class="focus:outline-none" transition:name="page-content" transition:animate={fade({ duration: '600ms' })}>
        {breadcrumbLabel && <Breadcrumbs current={breadcrumbLabel} />}
        <slot />
      </main>
      <SiteFooter />
    </div>
    <MobileNavDrawer />
  </body>
</html>
