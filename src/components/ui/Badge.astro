---
import Icon, { type IconName } from './Icon.astro';

type Tone = 'outline' | 'sage' | 'terracotta' | 'neutral' | 'forest';

interface Props {
  tone?: Tone;
  icon?: IconName;
  class?: string;
}

const { tone = 'neutral', icon, class: className } = Astro.props;

const tones: Record<Tone, string> = {
  outline: 'border border-line bg-surface/85 text-terracotta-hover backdrop-blur-md',
  sage: 'bg-sage-tint text-sage',
  terracotta: 'bg-terracotta-tint text-terracotta-hover',
  neutral: 'bg-tint text-muted',
  forest: 'bg-action text-white',
};
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[0.6875rem] leading-none font-semibold tracking-[0.08em] uppercase',
    tones[tone],
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-3.5" />}
  <slot />
</span>
