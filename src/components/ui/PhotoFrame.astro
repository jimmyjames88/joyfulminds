---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  aspect?: 'portrait' | 'landscape';
  objectPosition?: string;
  priority?: boolean;
  captionStyle?: 'overlay' | 'card';
}

const {
  src,
  alt,
  aspect = 'portrait',
  objectPosition = 'center',
  priority = false,
  captionStyle = 'overlay',
} = Astro.props;
const widths = [400, 640, 960].filter((width) => width < src.width).concat(src.width);
---

<figure class="relative isolate mx-auto w-full max-w-sm sm:max-w-md lg:max-w-none">
  <div
    class="absolute -inset-3 -rotate-2 rounded-3xl bg-terracotta-tint ring-1 ring-terracotta/10 sm:-inset-4"
    aria-hidden="true"
  >
  </div>
  <div class:list={[
    'relative overflow-hidden rounded-2xl bg-sage/20 shadow-lift',
    aspect === 'landscape' ? 'aspect-[16/10]' : 'aspect-4/5',
  ]}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes="(min-width: 1024px) 40vw, (min-width: 640px) 28rem, 90vw"
      quality="high"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="size-full object-cover"
      style={{ objectPosition }}
    />
  </div>
  {Astro.slots.has('caption') && (
    <figcaption class:list={[
      captionStyle === 'card'
        ? 'relative mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-line bg-surface p-4 shadow-card'
        : 'absolute inset-x-0 bottom-0 rounded-b-2xl bg-linear-to-t from-forest-deep/85 via-forest-deep/40 to-transparent px-6 pt-16 pb-5',
    ]}>
      <slot name="caption" />
    </figcaption>
  )}
</figure>
