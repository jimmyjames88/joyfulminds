---
interface Props {
  effect?: 'heart' | 'orbits' | 'breath' | 'connection' | 'ribbons' | 'embers' | 'ripples';
}

const { effect = 'heart' } = Astro.props;
---

<animated-hero-background class="hero-background" data-effect={effect} aria-hidden="true">
  <canvas></canvas>
</animated-hero-background>

<style>
  .hero-background {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    display: block;
    height: min(100%, 48rem);
    overflow: hidden;
    pointer-events: none;
    opacity: 0.7;
    background:
      radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--color-peach) 24%, transparent), transparent 65%),
      var(--color-canvas);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-background[data-effect='orbits'] {
    opacity: 0.875;
  }

  .hero-background[data-effect='connection'],
  .hero-background[data-effect='ribbons'] {
    opacity: 0.2;
  }

  .hero-background[data-effect='embers'] {
    opacity: 0.4;
  }

  .hero-background[data-effect='ripples'] {
    opacity: 0.245;
  }

  canvas[hidden] {
    display: none;
  }

  .hero-background::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(to bottom, transparent 65%, var(--color-canvas));
  }
</style>

<script>
  const vertexSource = `
    attribute vec2 a_position;
    void main() {
      gl_Position = vec4(a_position, 0.0, 1.0);
    }
  `;
  const heartSource = `
    precision mediump float;
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec3 u_base;
    uniform vec3 u_rose;
    uniform vec3 u_lilac;

    void main() {
      vec2 p = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      p.y += 0.12;
      p.y *= 1.15;
      float t = u_time * 0.45;
      float pulse = sin(t) * 0.08 + sin(t * 2.0) * 0.03;
      vec2 pos = p * (1.1 - pulse) / 1.2;
      float a = pos.x * pos.x + pos.y * pos.y - 0.45;
      float heartDist = a * a * a - pos.x * pos.x * pos.y * pos.y * pos.y;
      float glow = 0.035 / (abs(heartDist) + 0.04);
      float innerWarmth = exp(-length(pos - vec2(0.0, -0.1)) * 2.2);
      vec3 col = u_base;
      col += u_rose * glow * 0.28;
      col += vec3(1.0, 0.72, 0.45) * innerWarmth * 0.24 * (0.8 + 0.2 * sin(t * 2.0));
      col += u_lilac * glow * 0.15;
      vec2 uv = gl_FragCoord.xy / u_resolution.xy;
      float vig = uv.x * (1.0 - uv.x) * uv.y * (1.0 - uv.y);
      col *= clamp(16.0 * vig, 0.4, 1.0);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const orbitsSource = `
    precision mediump float;
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec3 u_base;

    void main() {
      vec2 uv = gl_FragCoord.xy / u_resolution.xy;
      vec2 p = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float t = u_time * 0.3125;
      vec2 p1 = vec2(-0.4, -0.1) + vec2(sin(t * 0.7) * 0.35, cos(t * 0.5) * 0.22);
      vec2 p2 = vec2(0.35, 0.15) + vec2(-sin(t * 0.6 + 0.5) * 0.38, -cos(t * 0.75) * 0.25);
      float d1 = length(p - p1);
      float d2 = length(p - p2);
      float glow1 = 0.25 / (d1 * d1 + 0.35);
      float glow2 = 0.22 / (d2 * d2 + 0.40);
      vec2 mid = (p1 + p2) * 0.5;
      float dMid = length(p - mid);
      float breath = 0.5 + 0.5 * sin(t * 1.2);
      float bridgeGlow = exp(-dMid * 2.2) * (0.35 + 0.25 * breath);
      vec3 col = u_base;
      col += vec3(0.65, 0.45, 0.90) * glow1 * 0.225;
      col += vec3(0.95, 0.65, 0.38) * glow2 * 0.175;
      col += vec3(0.85, 0.75, 1.0) * bridgeGlow * 0.225;
      float edgeVignette = smoothstep(0.0, 0.15, uv.y) * (1.0 - smoothstep(0.85, 1.0, uv.y));
      col = mix(vec3(0.07, 0.05, 0.10), col, edgeVignette);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const breathSource = `
    precision mediump float;
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec3 u_base;

    void main() {
      vec2 p = (gl_FragCoord.xy * 2.0 - u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float t = u_time * 0.45;
      float breath = sin(t) * 0.5 + 0.5;
      float pulseRadius = 0.55 + breath * 0.35;
      vec2 center = vec2(0.0, 0.0);
      float len = length(p - center);
      float ring1 = abs(len - pulseRadius);
      float ring2 = abs(len - (pulseRadius * 0.65));
      float ring3 = abs(len - (pulseRadius * 1.35));
      float glow1 = 0.045 / (ring1 + 0.08);
      float glow2 = 0.035 / (ring2 + 0.09);
      float glow3 = 0.030 / (ring3 + 0.12);
      float core = exp(-len * 1.8) * (0.4 + breath * 0.3);
      vec3 col = u_base;
      col += vec3(0.80, 0.58, 0.98) * glow1 * 0.22;
      col += vec3(0.96, 0.70, 0.40) * glow2 * 0.18;
      col += vec3(0.55, 0.38, 0.85) * glow3 * 0.15;
      col += vec3(0.95, 0.65, 0.45) * core * 0.22;
      gl_FragColor = vec4(col, 1.0);
    }
  `;
  const simplexNoiseSource = `
    vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }

    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
      vec2 i = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod289(i);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
      m = m * m;
      m = m * m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
      vec3 g;
      g.x = a0.x * x0.x + h.x * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }
  `;

  const connectionSource = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec3 u_base;
    ${simplexNoiseSource}

    void main() {
      vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      vec2 mouse = (u_mouse.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float t = u_time * 0.14;
      vec2 centerA = vec2(sin(t * 0.8) * 0.28 - 0.18, cos(t * 0.6) * 0.12);
      vec2 centerB = vec2(-sin(t * 0.8) * 0.28 + 0.18, -cos(t * 0.6) * 0.12);
      centerB += (mouse - centerB) * 0.15;
      float distA = length(p - centerA);
      float distB = length(p - centerB);
      float n = snoise(p * 2.2 + vec2(t * 0.3));
      float fieldA = exp(-distA * (2.8 + n * 0.5));
      float fieldB = exp(-distB * (2.8 + n * 0.5));
      float bridge = fieldA * fieldB * 4.0;
      vec3 warmAmber = vec3(1.0, 0.725, 0.333);
      vec3 luminousLilac = vec3(0.843, 0.729, 1.0);
      vec3 deepPlum = vec3(0.18, 0.11, 0.26);
      vec3 col = u_base;
      col += deepPlum * (fieldA + fieldB) * 0.8;
      col += warmAmber * pow(fieldA, 1.8) * 0.45;
      col += luminousLilac * pow(fieldB, 1.8) * 0.45;
      col += mix(warmAmber, luminousLilac, 0.5) * bridge * 0.75;
      float orbitA = 1.0 - smoothstep(0.0, 0.02, abs(distA - 0.38 - n * 0.04));
      float orbitB = 1.0 - smoothstep(0.0, 0.02, abs(distB - 0.38 - n * 0.04));
      col += warmAmber * orbitA * 0.12;
      col += luminousLilac * orbitB * 0.12;
      col *= 1.0 - smoothstep(0.3, 1.3, length(p * vec2(0.9, 1.2)));
      gl_FragColor = vec4(col, 1.0);
    }
  `;
  const ribbonsSource = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec3 u_base;

    void main() {
      vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      vec2 mouse = (u_mouse.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float t = u_time * 0.25;
      vec3 col = u_base;
      float mDist = length(p - mouse);
      p.y += sin(p.x * 2.0 - t * 0.5) * 0.05;
      p.y += (mouse.y - p.y) * 0.08 * exp(-mDist * 3.0);
      vec3 lilac = vec3(0.843, 0.729, 1.0);
      vec3 apricot = vec3(1.0, 0.725, 0.333);
      vec3 violet = vec3(0.66, 0.46, 0.94);

      for (int i = 0; i < 7; i++) {
        float fi = float(i) / 6.0;
        float freq = 1.4 + fi * 0.8;
        float phase = t * (0.6 + fi * 0.3) + float(i) * 0.9;
        float amplitude = 0.14 + 0.06 * sin(t * 0.4 + float(i));
        float waveY = sin(p.x * freq + phase) * amplitude;
        waveY += cos(p.x * (freq * 0.6) - phase * 0.7) * (amplitude * 0.5);
        float distToWave = abs(p.y - waveY);
        float line = 1.0 - smoothstep(0.0, 0.02, distToWave);
        float glow = exp(-distToWave * 16.0) * 0.5;
        vec3 lineColor = mix(apricot, lilac, fi);
        lineColor = mix(lineColor, violet, sin(p.x * 1.5 + phase) * 0.5 + 0.5);
        col += lineColor * (line * 0.5 + glow * 0.3) * (0.8 - abs(fi - 0.5) * 0.4);
      }

      float centerGlow = exp(-length(p) * 2.0) * 0.22;
      col += lilac * centerGlow;
      col *= 1.0 - smoothstep(0.3, 1.3, length(p * vec2(0.9, 1.2)));
      gl_FragColor = vec4(col, 1.0);
    }
  `;
  const embersSource = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec3 u_base;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    void main() {
      vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      vec2 mouse = (u_mouse.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float t = u_time * 0.2;
      vec3 col = u_base;
      vec3 deepGlow = vec3(0.15, 0.10, 0.22);
      col += deepGlow * (1.0 - length(p * vec2(0.8, 1.2)));
      vec3 amberGlow = vec3(1.0, 0.725, 0.333);
      vec3 lilacGlow = vec3(0.843, 0.729, 1.0);

      for (int layerIndex = 1; layerIndex <= 3; layerIndex++) {
        float layer = float(layerIndex);
        float speed = 0.18 * layer;
        vec2 gridUv = p * (4.0 * layer) + vec2(0.0, -t * speed);
        gridUv += (p - mouse) * 0.1 * exp(-length(p - mouse) * 3.0);
        vec2 id = floor(gridUv);
        vec2 f = fract(gridUv) - 0.5;

        for (int y = -1; y <= 1; y++) {
          for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 cellId = id + neighbor;
            float rnd = hash(cellId);
            float angle = rnd * 6.28 + u_time * (0.4 + rnd * 0.5);
            vec2 offset = vec2(sin(angle), cos(angle)) * 0.3;
            vec2 diff = neighbor + offset - f;
            float dist = length(diff);
            float pulse = 0.5 + 0.5 * sin(u_time * 1.5 + rnd * 10.0);
            float radius = 0.05 * pulse / layer;
            float sparkle = 1.0 - smoothstep(0.0, max(radius, 0.00001), dist);
            float halo = exp(-dist * (14.0 * layer)) * 0.4;
            vec3 pColor = (rnd > 0.45) ? amberGlow : lilacGlow;
            col += pColor * (sparkle + halo) * (0.35 / layer);
          }
        }
      }

      float hearth = smoothstep(-0.8, 0.6, -p.y) * exp(-abs(p.x) * 1.5);
      col += amberGlow * hearth * 0.18;
      col *= 1.0 - smoothstep(0.3, 1.3, length(p * vec2(0.9, 1.2)));
      gl_FragColor = vec4(col, 1.0);
    }
  `;
  const ripplesSource = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec3 u_base;
    ${simplexNoiseSource}

    void main() {
      vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      vec2 mouse = (u_mouse.xy - 0.5 * u_resolution.xy) / min(u_resolution.x, u_resolution.y);
      float breath = sin(u_time * 0.45) * 0.5 + 0.5;
      float slowTime = u_time * 0.15;
      p += (mouse - p) * 0.05 * exp(-length(p - mouse) * 2.5);
      float d = length(p);
      float angle = d > 0.0 ? atan(p.y, p.x) : 0.0;
      vec3 col = u_base;
      float waves = 0.0;

      for (int i = 1; i <= 5; i++) {
        float fi = float(i);
        float radius = fi * 0.16 + breath * 0.08 - slowTime * 0.05;
        radius = mod(radius, 0.85);
        float ringNoise = snoise(vec2(cos(angle * 2.0 + slowTime), sin(angle * 2.0 - slowTime)) * 1.5 + fi);
        float ringDist = abs(d - (radius + ringNoise * 0.035));
        float intensity = (1.0 - smoothstep(0.0, 0.04, ringDist)) * (1.0 - smoothstep(0.2, 0.85, radius));
        waves += intensity * (0.8 / fi);
      }

      vec3 lilac = vec3(0.843, 0.729, 1.0);
      vec3 warmAmber = vec3(1.0, 0.725, 0.333);
      vec3 deepPlum = vec3(0.18, 0.12, 0.25);
      col += deepPlum * (1.0 - smoothstep(0.1, 0.9, d));
      col += lilac * waves * 0.28;
      col += warmAmber * exp(-d * 4.0) * (0.4 + 0.3 * breath);
      col *= 1.0 - smoothstep(0.3, 1.3, d);
      gl_FragColor = vec4(col, 1.0);
    }
  `;
  const fragmentSources = {
    heart: heartSource,
    orbits: orbitsSource,
    breath: breathSource,
    connection: connectionSource,
    ribbons: ribbonsSource,
    embers: embersSource,
    ripples: ripplesSource,
  };

  function initialize(canvas: HTMLCanvasElement, effect: keyof typeof fragmentSources): () => void {
    const context = canvas.getContext('webgl', { alpha: false, antialias: false });
    if (!context) {
      console.warn(`Hero background (${effect}): WebGL unavailable; displaying the static background.`);
      return () => {};
    }
    const gl = context;

    const shaders: WebGLShader[] = [];
    const program = gl.createProgram();
    const buffer = gl.createBuffer();
    function release() {
      shaders.forEach((shader) => gl.deleteShader(shader));
      if (program) gl.deleteProgram(program);
      if (buffer) gl.deleteBuffer(buffer);
    }
    function fail(message: string) {
      console.error(`Hero background (${effect}): ${message}; displaying the static background.`);
      canvas.hidden = true;
      release();
    }
    if (!program || !buffer) {
      fail('Could not allocate WebGL resources');
      return () => {};
    }
    for (const [type, source] of [
      [gl.VERTEX_SHADER, vertexSource],
      [gl.FRAGMENT_SHADER, fragmentSources[effect]],
    ] as const) {
      const shader = gl.createShader(type);
      if (!shader) {
        fail('Could not create a shader');
        return () => {};
      }
      shaders.push(shader);
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        fail(`Shader compilation failed: ${gl.getShaderInfoLog(shader)}`);
        return () => {};
      }
      gl.attachShader(program, shader);
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      fail(`Shader linking failed: ${gl.getProgramInfoLog(program)}`);
      return () => {};
    }
    gl.useProgram(program);
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, 'a_position');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
    const timeUniform = gl.getUniformLocation(program, 'u_time');
    const resolutionUniform = gl.getUniformLocation(program, 'u_resolution');
    const mouseUniform = gl.getUniformLocation(program, 'u_mouse');
    const theme = getComputedStyle(document.documentElement);
    for (const [uniform, token] of [
      ['u_base', '--color-canvas'],
      ['u_rose', '--color-peach'],
      ['u_lilac', '--color-terracotta'],
    ]) {
      const hex = theme.getPropertyValue(token).trim();
      if (!/^#[\da-f]{6}$/i.test(hex)) {
        fail(`Expected a six-digit hex theme color for ${token}`);
        return () => {};
      }
      const channels = [1, 3, 5].map((offset) => parseInt(hex.slice(offset, offset + 2), 16) / 255);
      gl.uniform3f(gl.getUniformLocation(program, uniform), channels[0], channels[1], channels[2]);
    }

    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let lost = false;
    let frame = 0;
    let elapsed = 0;
    let previousTime = 0;
    function draw() {
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(resolutionUniform, canvas.width, canvas.height);
      gl.uniform1f(timeUniform, motion.matches ? 0 : elapsed);
      if (mouseUniform !== null) {
        gl.uniform2f(mouseUniform, canvas.width * 0.5, canvas.height * 0.5);
      }
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }
    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = 0;
    }
    function animate(time: number) {
      elapsed += previousTime ? Math.min(time - previousTime, 64) / 1000 : 0;
      previousTime = time;
      draw();
      frame = requestAnimationFrame(animate);
    }
    function update() {
      stop();
      if (lost) return;
      draw();
      if (visible && !document.hidden && !motion.matches) frame = requestAnimationFrame(animate);
    }
    function syncSize() {
      const ratio = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(canvas.clientWidth * ratio));
      canvas.height = Math.max(1, Math.round(canvas.clientHeight * ratio));
      update();
    }
    const resize = new ResizeObserver(syncSize);
    const intersection = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    function handleContextLoss(event: Event) {
      event.preventDefault();
      lost = true;
      stop();
      canvas.hidden = true;
      console.warn(`Hero background (${effect}): WebGL context lost; displaying the static background.`);
    }
    syncSize();
    resize.observe(canvas);
    intersection.observe(canvas);
    motion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    canvas.addEventListener('webglcontextlost', handleContextLoss);
    return () => {
      stop();
      resize.disconnect();
      intersection.disconnect();
      motion.removeEventListener('change', update);
      document.removeEventListener('visibilitychange', update);
      canvas.removeEventListener('webglcontextlost', handleContextLoss);
      release();
    };
  }

  class AnimatedHeroBackground extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const canvas = this.querySelector('canvas');
      if (!canvas) throw new Error('Animated hero background canvas was not found.');
      const effect = this.dataset.effect;
      if (effect !== 'heart' && effect !== 'orbits' && effect !== 'breath' && effect !== 'connection' && effect !== 'ribbons' && effect !== 'embers' && effect !== 'ripples') {
        throw new Error('Invalid animated hero background effect.');
      }
      this.cleanup = initialize(canvas, effect);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('animated-hero-background')) {
    customElements.define('animated-hero-background', AnimatedHeroBackground);
  }
</script>
