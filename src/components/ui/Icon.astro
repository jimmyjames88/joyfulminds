export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-4', strokeWidth = 1.75 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
