---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer';
  width?: 'wide' | 'content' | 'narrow';
  class?: string;
}

const { as: Tag = 'div', width = 'wide', class: className } = Astro.props;

const widths = {
  wide: 'max-w-7xl',
  content: 'max-w-5xl',
  narrow: 'max-w-4xl',
};
---

<Tag class:list={['mx-auto w-full px-6 sm:px-8 lg:px-12', widths[width], className]}>
  <slot />
</Tag>
