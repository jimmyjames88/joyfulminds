---
import { mailto, site } from '../../data/site';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const topics = [
  'Team building',
  'Communication Skills',
  'Understanding Brains at Work',
  'Managing Stress Responses',
  'Self-care/Work Life Balance',
  'Prioritizing Busy Schedules',
  'High Demand Work Places',
  'Grief in the Workplace',
];

const industries = [
  'Services',
  'Technology',
  'Finance',
  'Medical',
  'Dental',
  'Sales',
  'Small Businesses',
  'Energy',
];

const columnTitle = 'flex items-center gap-2.5 text-xl leading-[1.3] font-semibold';
const contactLink = 'flex items-center gap-2 rounded-sm text-[0.8125rem] font-medium text-forest hover:text-terracotta';
---

<section id="workshops" aria-labelledby="workshops-title" class="bg-tint py-20 lg:py-28">
  <Container>
    <SectionHeading
      id="workshops-title"
      align="center"
      eyebrow="Organizational Support"
      title="Team Workshops"
    >
      <p class="text-balance text-muted">
        Mental health workshops are built around the needs of your team at competitive rates. Please reach out to
        discuss how I can help support the well-being of your team.
      </p>
    </SectionHeading>

    <Card class="mt-12 grid gap-10 p-6 sm:p-10 md:grid-cols-2 md:gap-0 lg:mt-14 lg:px-14 lg:py-12">
      <div class="md:border-r md:border-line md:pr-10 lg:pr-12">
        <h3 class={columnTitle}>
          <Icon name="clipboard" class="size-[1.125rem] text-forest" />
          Common Topics
        </h3>
        <ul class="mt-6 grid gap-x-8 gap-y-3.5 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
          {
            topics.map((topic) => (
              <li class="flex gap-3 text-sm leading-snug text-ink/85">
                <span class="mt-[0.4375rem] size-1.5 shrink-0 rounded-full bg-peach" aria-hidden="true" />
                {topic}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col border-t border-line pt-10 md:border-t-0 md:pt-0 md:pl-10 lg:pl-12">
        <h3 class={columnTitle}>
          <Icon name="building" class="size-[1.125rem] text-forest" />
          Industries
        </h3>
        <ul class="mt-6 mb-8 flex flex-wrap gap-2">
          {
            industries.map((industry, i) => (
              <li
                class:list={[
                  'rounded-full px-3 py-1.5 text-xs font-medium',
                  i % 2 === 0 ? 'bg-sage-tint text-sage' : 'bg-peach-tint text-peach',
                ]}
              >
                {industry}
              </li>
            ))
          }
        </ul>

        <div class="border-t border-line pt-6 md:mt-auto">
          <h4 class="text-[0.6875rem] font-semibold tracking-[0.1em] text-ink uppercase">Corporate Inquiries</h4>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            <li>
              <a href={site.phoneHref} class={contactLink}>
                <Icon name="phone" class="size-3.5" />
                {site.phone}
              </a>
            </li>
            <li>
              <a href={mailto('Team workshop enquiry')} class={contactLink}>
                <Icon name="mail" class="size-3.5" />
                {site.email}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </Card>
  </Container>
</section>
