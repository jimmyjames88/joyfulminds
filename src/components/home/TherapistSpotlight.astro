---
import type { ImageMetadata } from 'astro';
import { consultHref, site } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import PhotoFrame from '../ui/PhotoFrame.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  portrait: ImageMetadata;
}

const { portrait } = Astro.props;
---

<section id="about" aria-labelledby="about-title" class="bg-canvas py-20 lg:py-28">
  <Container class="grid items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <PhotoFrame
      src={portrait}
      alt={`${site.practitioner}, ${site.credentials}, smiling outdoors`}
      objectPosition="center 30%"
    >
      <div slot="caption">
        <span class="block font-serif text-2xl leading-tight font-semibold text-white">{site.practitioner}</span>
        <span class="mt-1 block text-[0.625rem] font-medium tracking-[0.14em] text-white/80 uppercase">
          {site.credentials} • Social Worker
        </span>
      </div>
    </PhotoFrame>

    <div>
      <SectionHeading
        id="about-title"
        eyebrow="Compassionate, curious, and collaborative"
        title="Meet Rhonda"
      />

      <div class="mt-6 space-y-4 text-[0.9375rem] leading-[1.7] text-muted sm:text-base">
        <p>
          My approach is straightforward, warm, and non-judgemental. I believe therapy begins with a relationship where you feel understood and can trust the process. Together we will explore evidence based approaches that fit you and move you towards your goals.
        </p>
        <p>
          I guide adults through life's many challenges—life transitions, grief, relationships, trauma, stress. I approach each person with curiosity and compassion, recognizing the unique strengths, capacities, and wisdom they bring.
        </p>
        <p class="font-medium text-ink">
          Your experience and readiness set the pace. Our work may focus on practical strategies for managing symptoms and feeling better in the here and now, or we may explore the deeper roots of what is keeping you feeling stuck, stressed, or challenged.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={consultHref} variant="sage">Schedule a Consultation</Button>
        <Button href="/about" variant="outline">Learn More About Rhonda</Button>
      </div>
    </div>
  </Container>
</section>
