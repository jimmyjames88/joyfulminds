---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { consultHref, site } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  /** Portrait of Rhonda. Until supplied, a labelled placeholder frame is rendered. */
  portrait?: ImageMetadata;
}

const { portrait } = Astro.props;
---

<section id="about" aria-labelledby="about-title" class="bg-canvas py-20 lg:py-28">
  <Container class="grid items-center gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <figure class="relative mx-auto w-full max-w-sm sm:max-w-md lg:max-w-none">
      <div
        class="absolute -inset-3 -rotate-2 rounded-3xl bg-terracotta-tint ring-1 ring-terracotta/10 sm:-inset-4"
        aria-hidden="true"
      >
      </div>
      <div class="relative aspect-4/5 overflow-hidden rounded-2xl bg-sage/20 shadow-lift">
        {
          portrait ? (
            <Image
              src={portrait}
              alt={`${site.practitioner}, ${site.credentials}, smiling outdoors`}
              widths={[400, 640, 960].filter((w) => w < portrait.width).concat(portrait.width)}
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 28rem, 90vw"
              quality="high"
              class="size-full object-cover object-[center_30%]"
            />
          ) : (
            <div
              class="portrait-placeholder flex size-full items-start justify-center p-6 pt-[35%] text-center"
              data-placeholder="portrait"
              role="img"
              aria-label="Portrait photo placeholder"
            >
              <span class="rounded-full border border-dashed border-white/50 px-4 py-2 text-xs tracking-[0.1em] text-white/80 uppercase">
                Portrait photo to be added
              </span>
            </div>
          )
        }
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-linear-to-t from-forest-deep/85 via-forest-deep/40 to-transparent px-6 pt-16 pb-5"
        >
          <span class="block font-serif text-2xl leading-tight font-semibold text-white">{site.practitioner}</span>
          <span class="mt-1 block text-[0.625rem] font-medium tracking-[0.14em] text-white/80 uppercase">
            {site.credentials} • Social Worker
          </span>
        </figcaption>
      </div>
    </figure>

    <div>
      <SectionHeading
        id="about-title"
        eyebrow="Compassionate, curious, and collaborative."
        title="Meet Rhonda"
      />

      <div class="mt-6 space-y-4 text-[0.9375rem] leading-[1.7] text-muted sm:text-base">
        <p>
          My approach is straightforward, warm, and non-judgemental. I believe therapy begins with a relationship where you feel understood and can trust the process. Together we will explore evidence based approaches that fit you and move you towards your goals.
        </p>
        <p>
          I guide adults through life's many challenges—life transitions, grief, relationships, trauma, stress. I approach each person with curiosity and compassion, recognizing the unique strengths, capacities, and wisdom they bring.
        </p>
        <p class="font-medium text-ink">
          Your experience and readiness set the pace. Our work may focus on practical strategies for managing symptoms and feeling better in the here and now, or we may explore the deeper roots of what is keeping you feeling stuck, stressed, or challenged.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={consultHref} variant="sage">Schedule a Consultation</Button>
        <Button href="/about" variant="outline">Learn More About Rhonda</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .portrait-placeholder {
    background:
      radial-gradient(ellipse 45% 35% at 45% 38%, color-mix(in srgb, var(--color-canvas) 55%, transparent), transparent 70%),
      linear-gradient(160deg, var(--color-surface) 0%, var(--color-sage-tint) 55%, var(--color-forest-deep) 100%);
  }
</style>
