---
import { consultHref } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import FocusCard, { type FocusArea } from './FocusCard.astro';

const areas: FocusArea[] = [
  {
    title: 'Anxiety',
    icon: 'activity',
    accent: 'terracotta',
    description: 'Racing thoughts, worry, and the constant hum of ‘what if’.',
  },
  {
    title: 'Life transitions',
    icon: 'compass',
    accent: 'sage',
    description:
      'Career, identity, grief and loss, caregiving, parenting and schooling — the crossings that unsettle us.',
  },
  {
    title: "Women's health",
    icon: 'flower',
    accent: 'terracotta',
    description:
      'Pregnancy, menstruation, peri-menopause, menopause, post-menopause, and still managing day to day life.',
  },
  {
    title: 'Neurodivergence',
    icon: 'eye',
    accent: 'sage',
    description: 'ADHD, autism, and the lived experience of a different kind of mind.',
  },
  {
    title: 'Stress & burnout',
    icon: 'flame',
    accent: 'terracotta',
    description: 'When the load has been too heavy for too long.',
  },
  {
    title: 'PTSD',
    icon: 'shield',
    accent: 'sage',
    description: 'The aftermath of events that the nervous system has not finished processing.',
  },
  {
    title: 'Relationships',
    icon: 'users',
    accent: 'terracotta',
    description: 'Attachment injuries and old relational wounds that shape how safe connection feels now.',
  },
  {
    title: 'Traumatic events',
    icon: 'heart',
    accent: 'sage',
    description: 'Single-incident or complex trauma, held with care and pacing.',
  },
  {
    title: 'Illness, injury, medical changes',
    icon: 'cross',
    accent: 'terracotta',
    description:
      'Navigating diagnosis, recovery, and the emotional weight of changes to your body or health.',
  },
  {
    title: 'Wellness',
    icon: 'sprout',
    accent: 'sage',
    description:
      'Counselling is one way to increase your wellness — building the awareness, skills, and steadiness that help you meet daily life with more ease and grow your capacity over time.',
  },
];
---

<section id="focus" aria-labelledby="focus-title" class="bg-canvas py-20 lg:py-28">
  <Container>
    <SectionHeading id="focus-title" title="Counselling" align="center">
      <p class="text-center">
        I offer general counselling services to individuals currently residing in the provinces of Alberta and Ontario. Privacy and confidentiality are of the utmost importance, and we will discuss how to maintain this over virtual sessions prior to commencing.
      </p>
      <p class="text-center text-sm text-muted italic">
        These are the areas I work with most. You do not need a tidy label to begin — many people arrive with a mix of the below, and we make sense of it together.
      </p>
    </SectionHeading>

    <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
      {areas.map((area) => <FocusCard area={area} />)}
      <li class="flex flex-col rounded-2xl border border-sage/20 bg-sage-tint p-6 shadow-card sm:p-7">
        <h3 id="pathway-title" class="text-[1.375rem] leading-[1.3] font-semibold">
          Not sure where you fit or what modality you need?
        </h3>
        <p class="mt-2 text-sm leading-[1.6] text-muted">
          We can discuss your individual goals during a free, zero-pressure 30-minute virtual consultation.
        </p>
        <div class="mt-auto pt-6">
          <Button href="#" variant="sage" size="sm">Connect with Rhonda</Button>
        </div>
      </li>
    </ul>
  </Container>
</section>
