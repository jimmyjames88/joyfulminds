---
import { focusAreas } from '../../data/focusAreas';
import FocusAccordion from '../FocusAccordion.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="focus" aria-labelledby="focus-title" class="bg-tint py-20 lg:py-28">
  <Container>
    <SectionHeading id="focus-title" title="Areas of Focus" align="center">
      <p class="text-center">
        I offer general counselling services to individuals currently residing in the provinces of Alberta and Ontario. Privacy and confidentiality are of the utmost importance, and we will discuss how to maintain this over virtual sessions prior to commencing.
      </p>
      <p class="text-center text-sm text-muted italic">
        These are the areas I work with most. You do not need a tidy label to begin — many people arrive with a mix of the below, and we make sense of it together.
      </p>
    </SectionHeading>

    <FocusAccordion areas={focusAreas} />

    <div class="mt-8 rounded-2xl border border-sage/20 bg-sage-tint p-6 shadow-card sm:p-7 text-center">
        <h3 id="pathway-title" class="text-[1.375rem] leading-[1.3] font-semibold">
          Not sure where you fit?
        </h3>
        <p class="mt-2 text-sm leading-[1.6] text-muted">
          We can discuss your individual goals during a free, zero-pressure 30-minute virtual consultation.
        </p>
        <div class="mt-auto pt-6">
          <Button href="#" variant="sage">Connect with Rhonda</Button>
        </div>
    </div>
  </Container>
</section>
