---
import type { FocusArea } from '../../data/focusAreas';
import Icon from '../ui/Icon.astro';

interface Props {
  area: FocusArea;
  index: number;
}

const { area, index } = Astro.props;
---

<li>
  <details class="group rounded-2xl border border-line bg-surface shadow-card">
    <summary class="flex cursor-pointer list-none items-center gap-3 rounded-2xl p-4 transition-colors hover:bg-tint sm:gap-4 sm:p-5 [&::-webkit-details-marker]:hidden">
      <span class="w-5 shrink-0 text-xs font-medium text-terracotta tabular-nums" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
      <span
        class:list={[
          'grid size-10 shrink-0 place-items-center rounded-xl',
          area.accent === 'terracotta' ? 'bg-sage-tint text-sage' : 'bg-peach-tint text-peach',
        ]}
      >
        <Icon name={area.icon} class="size-5" />
      </span>
      <h3 class="min-w-0 flex-1 text-lg leading-snug font-semibold sm:text-xl">{area.title}</h3>
      <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line bg-tint text-terracotta">
        <Icon name="arrow-down" class="size-4 transition-transform group-open:rotate-180" />
      </span>
    </summary>
    <div class="border-t border-line px-5 py-4 sm:px-6 sm:py-5">
      <p class="text-sm leading-relaxed text-muted sm:pl-17">{area.description}</p>
    </div>
  </details>
</li>
