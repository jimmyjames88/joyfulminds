---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

export interface PricingTier {
  label: string;
  labelTone: 'sage' | 'terracotta' | 'neutral';
  title: string;
  description: string;
  price: string;
  duration: string;
  features: string[];
  cta: { label: string; href: string };
  /** Floating ribbon label for the highlighted tier. */
  featured?: string;
}

interface Props {
  tier: PricingTier;
}

const { tier } = Astro.props;
const featured = Boolean(tier.featured);
---

<li
  class:list={[
    'relative flex flex-col rounded-3xl border bg-surface p-7 sm:p-8',
    featured ? 'border-sage/60 shadow-lift lg:-my-3 lg:py-11' : 'border-line shadow-card',
  ]}
>
  {
    featured && (
      <Badge tone="forest" class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-2 whitespace-nowrap">
        {tier.featured}
      </Badge>
    )
  }

  <Badge tone={tier.labelTone} class="self-start">{tier.label}</Badge>
  <h3 class="mt-5 text-[1.375rem] leading-[1.3] font-semibold tracking-[-0.01em]">{tier.title}</h3>
  <p class="mt-2 text-sm leading-[1.6] text-muted">{tier.description}</p>

  <p class="mt-6 flex items-baseline gap-1.5 border-b border-line pb-6">
    <span class="font-serif text-4xl font-semibold text-forest">{tier.price}</span>
    <span class="text-sm text-muted">/ {tier.duration}</span>
  </p>

  <ul class="mt-6 mb-8 space-y-3">
    {
      tier.features.map((feature) => (
        <li class="flex items-start gap-2.5 text-sm text-ink/85">
          <Icon name="check" class="mt-0.5 size-4 text-peach" strokeWidth={2} />
          {feature}
        </li>
      ))
    }
  </ul>

  <Button href={tier.cta.href} variant={featured ? 'forest' : 'sage'} size="md" block class="mt-auto">
    {tier.cta.label}
  </Button>
</li>
