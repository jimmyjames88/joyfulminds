---
import { primaryNav } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';

const onHomePage = Astro.url.pathname === '/';
const getNavHref = (href: string) => {
  if (href.startsWith('/')) return href;
  if (onHomePage) return href;
  return `/${href}`;
};
const bookingHref = onHomePage ? '#booking' : '/#booking';
---

<header class="sticky top-0 z-50 border-b border-line bg-forest-deep/95 backdrop-blur-md">
  <Container class="flex h-18 items-center justify-between gap-6 py-2">
    <a href="/" class="rounded-md" aria-label="Joyful Minds Counselling — home">
      <Logo theme="dark" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={getNavHref(link.href)}
                class="rounded-sm text-sm whitespace-nowrap text-ink/80 transition-colors hover:text-terracotta"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden sm:contents">
        <Button href={bookingHref} variant="forest" size="sm" icon="arrow-up-right" class="whitespace-nowrap">Book Appointment</Button>
      </span>

      <details class="group relative lg:hidden" data-mobile-nav>
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-line bg-surface text-forest [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="close" class="hidden size-5 group-open:block" />
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute top-full right-0 mt-3 w-64 rounded-2xl border border-line bg-surface p-3 shadow-lift"
        >
          <ul class="flex flex-col">
            {
              primaryNav.map((link) => (
                <li>
                  <a
                    href={getNavHref(link.href)}
                    class="block rounded-xl px-4 py-3 text-sm text-ink hover:bg-tint hover:text-terracotta"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <span class="block sm:hidden">
            <Button href={bookingHref} variant="forest" size="sm" block icon="arrow-up-right" class="mt-2">
              Book Appointment
            </Button>
          </span>
        </nav>
      </details>
    </div>
  </Container>
</header>

<script>
  // Close the mobile disclosure after navigating or pressing Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
