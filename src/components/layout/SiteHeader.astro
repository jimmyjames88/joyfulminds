---
import { primaryNav, serviceNav } from '../../data/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';

const onHomePage = Astro.url.pathname === '/';
const getNavHref = (href: string) => {
  if (href.startsWith('/')) return href;
  if (onHomePage) return href;
  return `/${href}`;
};
const bookingHref = onHomePage ? '#booking' : '/#booking';
---

<header class="sticky top-0 z-50 border-b border-line bg-forest-deep/50 backdrop-blur-md">
  <Container class="flex h-18 items-center justify-between gap-6 py-2">
    <a href="/" class="rounded-md" aria-label="Joyful Minds Counselling — home">
      <Logo theme="dark" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          primaryNav.map((link) => (
            link.label === 'Services' ? (
              <li>
                <details class="group relative" data-services-menu>
                  <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-sm text-sm whitespace-nowrap text-ink/80 transition-colors hover:text-terracotta focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-terracotta [&::-webkit-details-marker]:hidden">
                    Services
                    <Icon name="arrow-down" class="size-3 transition-transform group-open:rotate-180" />
                  </summary>
                  <ul class="absolute top-full left-0 z-50 mt-3 w-64 rounded-2xl border border-line bg-surface p-2 shadow-lift">
                    {serviceNav.map((service) => (
                      <li>
                        <a
                          href={service.href}
                          class="block rounded-xl px-4 py-2.5 text-sm text-ink hover:bg-tint hover:text-terracotta"
                        >
                          {service.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={getNavHref(link.href)}
                  class="rounded-sm text-sm whitespace-nowrap text-ink/80 transition-colors hover:text-terracotta"
                >
                  {link.label}
                </a>
              </li>
            )
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden sm:contents">
        <Button href={bookingHref} variant="forest" size="sm" icon="arrow-up-right" class="whitespace-nowrap">Book Appointment</Button>
      </span>

      <button
        type="button"
        class="grid size-10 place-items-center rounded-full border border-line bg-surface text-forest focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta lg:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        data-mobile-nav-toggle
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </Container>
</header>
