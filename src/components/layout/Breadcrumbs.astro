---
import Container from '../ui/Container.astro';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<Container class="pt-5">
  <nav aria-label="Breadcrumb" class="text-xs leading-relaxed text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a href="/" class="rounded-sm underline-offset-4 hover:text-terracotta hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{current}</li>
    </ol>
  </nav>
</Container>
